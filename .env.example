# Shinigami API base from the supplied TXT. You can replace this adapter later.
SHNGM_API_BASE=https://api.shngm.io/v1
PORT=8787
# Akun: rahasia penanda token (opsional, otomatis dibuat di folder data/ kalau kosong)
# AUTH_SECRET=isi-dengan-teks-acak-panjang
# DATA_DIR=./data

# Moderasi komentar
# ADMIN_TOKEN=isi-token-admin-panjang   (wajib diisi kalau mau pakai endpoint admin: lihat laporan, ban, hapus)
# SPOILER_AUTOBAN=0   (matikan ban otomatis untuk spoiler yang terdeteksi; default aktif)
