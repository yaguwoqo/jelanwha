# Backend katalog
SHNGM_API_BASE=https://api.shngm.io/v1
PORT=8787

# Firebase Web App config (Firebase Console > Project settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=isi_api_key_firebase
VITE_FIREBASE_AUTH_DOMAIN=project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=project-id
VITE_FIREBASE_STORAGE_BUCKET=project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=isi_sender_id
VITE_FIREBASE_APP_ID=isi_app_id

# Firebase Admin SDK untuk memverifikasi ID token di backend.
# Unduh service account JSON dari Firebase Console > Project settings > Service accounts.
# Simpan file JSON di lokasi privat, jangan masukkan ke ZIP atau Git.
FIREBASE_PROJECT_ID=project-id
FIREBASE_SERVICE_ACCOUNT_PATH=/path/ke/service-account.json

# Opsional: token admin moderasi komentar
# ADMIN_TOKEN=isi-token-admin-panjang
# SPOILER_AUTOBAN=0
